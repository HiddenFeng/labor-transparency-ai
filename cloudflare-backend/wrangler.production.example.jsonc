{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "labor-transparency-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "vars": {
    "LTP_ENV": "production",
    "LTP_ALLOWED_ORIGINS": "https://example.invalid",
    "LTP_COOKIE_SECURE": "true",
    "LTP_SEED": "false",
    "LTP_RESEARCH_SCHEDULED": "true",
    "LTP_RESEARCH_MAX_COMPANIES_PER_RUN": "2"
  },
  "triggers": {"crons": ["0 1 * * *"]}
}
