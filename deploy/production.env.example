# EXAMPLE ONLY. Do not copy these placeholder values into a real deployment.
# Generate LTP_ADMIN_TOKEN and LTP_SECURITY_SECRET independently with a cryptographic RNG.
LTP_RUNTIME_PROFILE=production
LTP_DB=/var/lib/labor-transparency/ltp.sqlite3
LTP_ADMIN_TOKEN=<GENERATE-INDEPENDENT-RANDOM-VALUE-AT-LEAST-32-CHARS>
LTP_SECURITY_SECRET=<GENERATE-A-DIFFERENT-RANDOM-VALUE-AT-LEAST-32-CHARS>
LTP_ALLOWED_HOSTS=labor.example.org
LTP_ALLOWED_ORIGINS=https://labor.example.org

# Recommended architecture: same-host reverse proxy terminates TLS; app stays loopback-only.
LTP_PROXY_MODE=reverse-proxy
LTP_FORWARDED_ALLOW_IPS=127.0.0.1

# Mandatory production admin-network gate. Use only the exact operator/VPN egress IPs
# that should reach /api/admin; no wildcard and no CIDR are accepted.
LTP_ADMIN_ALLOWED_IPS=203.0.113.10

LTP_READ_LIMIT_PER_MINUTE=300
LTP_MUTATION_LIMIT_PER_MINUTE=60
LTP_ADMIN_LIMIT_PER_MINUTE=30

# Production attachments are fail-closed by default. Enable only after ClamAV is installed
# and use an absolute executable path, e.g. LTP_CLAMSCAN_PATH=/usr/bin/clamscan.
LTP_ATTACHMENT_UPLOADS=disabled
# LTP_CLAMSCAN_PATH=/absolute/path/to/clamscan

LTP_PUBLIC_RESEARCH_MODE=false
LTP_RESEARCH_NETWORK_ENABLED=false
LTP_TZ=Asia/Tokyo
LTP_PUBLISH_HOUR=9
