# Local-safe defaults. Copy to deploy/self-host/.env and edit.
LTP_INSTANCE_NAME=My Labor Transparency Community
LTP_INSTANCE_OPERATOR=My Public-Interest Group

# For local HTTP testing leave public URL empty, site address :80 and secure cookie false.
LTP_INSTANCE_PUBLIC_URL=
LTP_SITE_ADDRESS=:80
LTP_HTTP_BIND=127.0.0.1:8080
LTP_HTTPS_BIND=127.0.0.1:8443
LTP_SELF_HOST_SECURE_COOKIE=false
LTP_SELF_HOST_ALLOWED_HOSTS=localhost,127.0.0.1
LTP_IMAGE_REVISION=local

# Public deployment example (replace values; do not expose app:8787 directly):
# LTP_INSTANCE_PUBLIC_URL=https://labor.example.org
# LTP_SITE_ADDRESS=labor.example.org
# LTP_HTTP_BIND=0.0.0.0:80
# LTP_HTTPS_BIND=0.0.0.0:443
# LTP_SELF_HOST_SECURE_COOKIE=true
# LTP_SELF_HOST_ALLOWED_HOSTS=labor.example.org
